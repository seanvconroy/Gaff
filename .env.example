# Local development. Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgres://gaff:gaff@localhost:5432/gaff_dev
APP_URL=http://localhost:3000
# At least 32 random characters: openssl rand -base64 32
AUTH_SECRET=replace-with-at-least-32-random-characters

# Providers. Locally: a development outbox, a fake SMS sender and a fake AI.
# EMAIL_PROVIDER: dev, resend or mailgun.
EMAIL_PROVIDER=dev
SMS_PROVIDER=fake
AI_PROVIDER=fake
INBOUND_DOMAIN=in.gaff.test
MAIL_FROM_DOMAIN=mail.gaff.test

# Shows the development outbox at /dev/outbox. Must be 0 in production.
DEV_TOOLS=1

# Resend (EMAIL_PROVIDER=resend, ADR-0014): an API key, and the signing secret of the webhook
# that sends received emails to /api/inbound/resend.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Mailgun, EU region (EMAIL_PROVIDER=mailgun)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_WEBHOOK_SIGNING_KEY=

# Sinch, EU region (SMS_PROVIDER=sinch)
SINCH_SERVICE_PLAN_ID=
SINCH_API_TOKEN=
SINCH_FROM=

# Claude on Amazon Bedrock, EU (AI_PROVIDER=bedrock). Credentials come from the standard AWS variables.
AWS_REGION=eu-west-1
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5

# Retention, in line with open question Q3. The solicitor confirms these before launch.
RETENTION_PERSONAL_DAYS=30
RETENTION_RECORD_MONTHS=12

# Where this deployment runs: development, test, staging or production. On Vercel it defaults to
# production (the strictest), and APP_URL defaults to the deployment's own address.
GAFF_ENV=development

# ADR-0014, Vercel only (docs/deploy.md): Vercel Cron sends CRON_SECRET to /api/cron/tick every
# minute; required for staging and production. Jobs also run straight after the request that
# queued them (RUN_JOBS_AFTER_REQUESTS, on by default on Vercel). Locally, `pnpm worker` runs them.
# CRON_SECRET=
# RUN_JOBS_AFTER_REQUESTS=0

# Supabase's CA certificate (PEM), so the database's certificate is checked. Set it in production.
# DATABASE_CA_CERT=

# Gaff's own team (UX-TS-5): email addresses, separated by commas, that can open the internal
# pages at /internal (the funnels, and the agencies waiting to be confirmed). Empty means nobody
# can. Everyone else gets "not found". Sign in with one of these addresses as usual, then open
# /internal/agencies or /internal/funnels.
STAFF_EMAILS=

# The PSRA register (UX-AG-1, Q39): where Gaff's weekly copy comes from. "sample" is a made-up
# register for local work and tests; production refuses it. "url" downloads the register from
# PSRA_REGISTER_URL, in the format src/domain/register/parse.ts expects (docs/deploy.md).
PSRA_REGISTER_SOURCE=sample
# PSRA_REGISTER_URL=

# Address search when adding a letting (UX-LT-9, Q40). "sample" is a made-up list of addresses
# for local work and tests; production refuses it. "off" looks nothing up: the address is typed
# into the manual fields. Autoaddress joins this list once its DPA is signed.
ADDRESS_SEARCH=sample

# Reading a pasted advert into a letting (UX-LT-1 to UX-LT-3). "on" reads it with AI_PROVIDER
# (the local stand-in, or Claude on Bedrock in the EU). "off" offers only "Fill it in myself".
# No link is ever fetched (Q31).
ADVERT_READER=on

# Where homes' photos are kept (UX-LT-10). "local" is a table in this database, for local work
# and tests; production refuses it. "supabase" is Supabase Storage in Ireland: a private bucket
# (PHOTO_BUCKET, "homes" unless set), the project's address and its service-role key.
PHOTO_STORE=local
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# PHOTO_BUCKET=homes

# Whether search engines may index live homes' public pages (UX-LS-11). "off" (the default)
# marks every page noindex, so a local, test or preview copy of Gaff is never found. Set "on" in
# production only. It is read when the app is built and when it starts.
SEARCH_INDEXING=off

# Next.js anonymous telemetry off.
NEXT_TELEMETRY_DISABLED=1

# R18 checks: "stand_in" (a development page) until the founders approve providers; "none" in
# production for now, so the operator arranges ID and income checks themselves.
IDENTITY_PROVIDER=stand_in
INCOME_PROVIDER=stand_in
# ADR-0005: 32 random bytes, base64 (openssl rand -base64 32). Required in production.
# DATA_ENCRYPTION_KEY=

# Sign-in (UX-SI-1, Q30, ADR-0015). Email codes and passkeys need nothing here. "Continue with
# Google" and "Continue with Apple" are each switched on by setting both of their values; with
# neither, the button isn't shown. Locally, with DEV_TOOLS=1 and these left empty, a stand-in
# page takes their place (/dev/sign-in/google), so nothing needs a real account to build.
# Google: an OAuth client (web application). Redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: the Services ID, and the client secret (a token signed with Apple's key; Apple accepts
# one for at most six months, so it has to be renewed). Return URL:
# <APP_URL>/api/auth/callback/apple. Register MAIL_FROM_DOMAIN with Apple too, so "Hide My
# Email" addresses can be reached (UX-SI-11).
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
