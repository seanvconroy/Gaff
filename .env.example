# Local development. Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgres://gaff:gaff@localhost:5432/gaff_dev
APP_URL=http://localhost:3000
# At least 32 random characters: openssl rand -base64 32
AUTH_SECRET=replace-with-at-least-32-random-characters

# Providers. Locally: a development outbox, a fake SMS sender and a fake AI.
# EMAIL_PROVIDER: dev, resend or mailgun.
EMAIL_PROVIDER=dev
SMS_PROVIDER=fake
AI_PROVIDER=fake
INBOUND_DOMAIN=in.gaff.test
MAIL_FROM_DOMAIN=mail.gaff.test

# Shows the development outbox at /dev/outbox. Must be 0 in production.
DEV_TOOLS=1

# Resend (EMAIL_PROVIDER=resend, ADR-0014): an API key, and the signing secret of the webhook
# that sends received emails to /api/inbound/resend.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Mailgun, EU region (EMAIL_PROVIDER=mailgun)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_WEBHOOK_SIGNING_KEY=

# Sinch, EU region (SMS_PROVIDER=sinch)
SINCH_SERVICE_PLAN_ID=
SINCH_API_TOKEN=
SINCH_FROM=

# The AI (Q37): "fake" locally and in tests; "anthropic" (the Claude API, with ANTHROPIC_API_KEY)
# on the test copy, with made-up data only; "bedrock" in production. Bedrock's credentials come
# from the standard AWS variables.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AWS_REGION=eu-west-1
# P4: the month's AI spend in US dollars; past it, every task falls back to people.
AI_MONTHLY_BUDGET_USD=100
# P8: tasks switched off, comma-separated: answers, description, wording, document.
AI_TASKS_OFF=

# Retention, in line with open question Q3. The solicitor confirms these before launch.
RETENTION_PERSONAL_DAYS=30
RETENTION_RECORD_MONTHS=12

# Where this deployment runs: development, test, staging or production. On Vercel it defaults to
# production (the strictest), and APP_URL defaults to the deployment's own address.
GAFF_ENV=development

# ADR-0014, Vercel only (docs/deploy.md): Vercel Cron sends CRON_SECRET to /api/cron/tick every
# minute; required for staging and production. Jobs also run straight after the request that
# queued them (RUN_JOBS_AFTER_REQUESTS, on by default on Vercel). Locally, `pnpm worker` runs them.
# CRON_SECRET=
# RUN_JOBS_AFTER_REQUESTS=0

# Supabase's CA certificate (PEM), so the database's certificate is checked. Set it in production.
# DATABASE_CA_CERT=

# Next.js anonymous telemetry off.
NEXT_TELEMETRY_DISABLED=1

# R18 checks: "stand_in" (a development page) until the founders approve providers; "none" in
# production for now, so the operator arranges ID and income checks themselves.
IDENTITY_PROVIDER=stand_in
INCOME_PROVIDER=stand_in
# ADR-0005: 32 random bytes, base64 (openssl rand -base64 32). Required in production.
# DATA_ENCRYPTION_KEY=

# M43: listing photos. "local" keeps files under .data/storage, served by /api/dev/storage.
# Production: "supabase", with the service key (server only) and two buckets: a private one for
# uploads and a public one for the photos renters see (docs/launch-checklist.md).
STORAGE_PROVIDER=local
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# STORAGE_UPLOADS_BUCKET=uploads
# STORAGE_MEDIA_BUCKET=listing-photos

# M24 (Q29): the ID check on private landlords. "stand_in" is a development page; production
# uses Stripe Identity, with its webhook (identity.verification_session.*) at
# /api/webhooks/stripe-identity.
LETTER_IDENTITY_PROVIDER=stand_in
# STRIPE_SECRET_KEY=
# STRIPE_IDENTITY_WEBHOOK_SECRET=

# The marketplace's public side (renter sign-up, search): off until launch (ADR-0015).
MARKETPLACE_PUBLIC=0

# M86: alert emails' own sending subdomain (optional; defaults to MAIL_FROM_DOMAIN), and how long
# new homes are grouped into one instant alert, in seconds.
# ALERTS_MAIL_FROM_DOMAIN=alerts.gaff.ie
# ALERT_GROUP_SECONDS=120

# M57 (ADR-0027): the search map. "static" is a stand-in drawn from Gaff's own data, for
# development, tests and the test copy (the default everywhere but production); "none" shows the
# list alone (production's default).
# Production uses "google": the Maps JavaScript API only, with a browser key restricted to Gaff's
# domains and to that API, and a vector Map ID (a dark one too, if there is one).
# MAP_PROVIDER=google
# GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_MAP_ID=
# GOOGLE_MAPS_MAP_ID_DARK=
