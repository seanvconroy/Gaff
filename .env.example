# Local development. Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgres://gaff:gaff@localhost:5432/gaff_dev
APP_URL=http://localhost:3000
# At least 32 random characters: openssl rand -base64 32
AUTH_SECRET=replace-with-at-least-32-random-characters

# Providers. Locally: a development outbox, a fake SMS sender and a fake AI.
# EMAIL_PROVIDER: dev, resend or mailgun.
EMAIL_PROVIDER=dev
SMS_PROVIDER=fake
AI_PROVIDER=fake
INBOUND_DOMAIN=in.gaff.test
MAIL_FROM_DOMAIN=mail.gaff.test
# Interim: send everything from one address, e.g. onboarding@resend.dev. Leave empty normally.
# MAIL_FROM_ADDRESS=onboarding@resend.dev

# Shows the development outbox at /dev/outbox. Must be 0 in production.
DEV_TOOLS=1

# Resend (EMAIL_PROVIDER=resend, ADR-0014): an API key, and the signing secret of the webhook
# that sends received emails to /api/inbound/resend.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Mailgun, EU region (EMAIL_PROVIDER=mailgun)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_WEBHOOK_SIGNING_KEY=

# Sinch, EU region (SMS_PROVIDER=sinch)
SINCH_SERVICE_PLAN_ID=
SINCH_API_TOKEN=
SINCH_FROM=
# Sign-in by mobile number (ADR-0033) is offered wherever texts are really sent (SMS_PROVIDER=sinch),
# and locally with DEV_TOOLS=1, where the text is in the outbox. This is every sign-in text Gaff
# may send in an hour, to anyone: past it, sign-in asks for an email until the hour is out.
# 0 switches sign-in by mobile off.
SIGN_IN_TEXTS_PER_HOUR=300

# The AI (ADR-0017). AI_PROVIDER: fake (a local stand-in), anthropic (the Claude API, for the
# test copy and development with made-up details only; production refuses it) or bedrock
# (Claude on Amazon Bedrock in Dublin, for production; credentials come from the standard AWS
# variables).
ANTHROPIC_API_KEY=
AWS_REGION=eu-west-1
# One model for every task. Bedrock adds its "anthropic." prefix itself.
AI_MODEL=claude-opus-5-5
# The month's AI spend in US dollars. At 80% STAFF_EMAILS get one email; at 100% people take over.
AI_MONTHLY_BUDGET_USD=100
# Tasks switched off without a code change: answers, advert, people, or all, separated by commas.
AI_TASKS_OFF=

# Retention, in line with open question Q3. The solicitor confirms these before launch.
RETENTION_PERSONAL_DAYS=30
RETENTION_RECORD_MONTHS=12

# Where this deployment runs: development, test, staging or production. On Vercel it defaults to
# production (the strictest), and APP_URL defaults to the deployment's own address.
GAFF_ENV=development

# ADR-0014, Vercel only (docs/deploy.md): Vercel Cron sends CRON_SECRET to /api/cron/tick every
# minute; required for staging and production. Jobs also run straight after the request that
# queued them (RUN_JOBS_AFTER_REQUESTS, on by default on Vercel). Locally, `pnpm worker` runs them.
# CRON_SECRET=
# RUN_JOBS_AFTER_REQUESTS=0

# Supabase's CA certificate (PEM), so the database's certificate is checked. Set it in production.
# DATABASE_CA_CERT=

# Gaff's own team (UX-TS-5): email addresses, separated by commas, that can open the internal
# pages at /internal (the funnels, and the agencies waiting to be confirmed). Empty means nobody
# can. Everyone else gets "not found". Sign in with one of these addresses as usual, then open
# /internal/agencies or /internal/funnels.
STAFF_EMAILS=

# The PSRA register (UX-AG-1, Q39): where Gaff's weekly copy comes from. "sample" is a made-up
# register for local work and tests; production refuses it. "url" downloads the register from
# PSRA_REGISTER_URL, in the format src/domain/register/parse.ts expects (docs/deploy.md).
PSRA_REGISTER_SOURCE=sample
# PSRA_REGISTER_URL=

# Address search when adding a letting (UX-LT-9, Q40). "sample" is a made-up list of addresses
# for local work and tests; production refuses it. "off" looks nothing up: the address is typed
# into the manual fields. Autoaddress joins this list once its DPA is signed.
ADDRESS_SEARCH=sample

# Reading a pasted advert into a letting (UX-LT-1 to UX-LT-3). "on" reads it with AI_PROVIDER,
# as its "advert" task. "off" offers only "Fill it in myself".
# No link is ever fetched (Q31).
ADVERT_READER=on

# Where homes' photos are kept (UX-LT-10). "local" is a table in this database, for local work
# and tests; production refuses it. "supabase" is Supabase Storage in Ireland: a private bucket
# (PHOTO_BUCKET, "homes" unless set), the project's address and its service-role key.
PHOTO_STORE=local
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# PHOTO_BUCKET=homes

# Where chosen renters' work and income documents are kept (BA-16, P53), encrypted with
# DATA_ENCRYPTION_KEY on top of the store's own. "local" is a table in this database, for local
# work and tests; production refuses it. "supabase" is a private bucket of its own in Supabase
# Storage in Ireland (DOCUMENT_BUCKET, "documents" unless set; never the photos' bucket), with
# the SUPABASE_ settings above. The test copy reads documents with the Claude API: made-up
# documents only.
DOCUMENT_STORE=local
# DOCUMENT_BUCKET=documents

# Whether search engines may index live homes' public pages (UX-LS-11). "off" (the default)
# marks every page noindex, so a local, test or preview copy of Gaff is never found. Set "on" in
# production only. It is read when the app is built and when it starts.
SEARCH_INDEXING=off

# The search map and the lister's pin (BA-5, ADR-0021). "static" is the stand-in drawn from
# Gaff's own data (development, tests, a copy without a key); "google" is Google Maps, the Maps
# JavaScript API only; "none" is the list alone. Unset: the stand-in, except in production, where
# it's none until a key is set. Google's settings are read when the app is built (the content
# security policy of the map's pages) and when it starts: redeploy after changing them. The key
# is public by design: restrict it to Gaff's addresses and the Maps JavaScript API, with a daily
# cap (docs/deploy.md, "The search map"). A preview copy always shows the stand-in.
MAP_PROVIDER=static
# GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_MAP_ID=
# GOOGLE_MAPS_MAP_ID_DARK=
# GOOGLE_MAPS_VERSION=quarterly

# Next.js anonymous telemetry off.
NEXT_TELEMETRY_DISABLED=1

# R18 checks. The ID check (Q51, ADR-0020): "stripe" is Stripe Identity, "stand_in" a development
# page where you pick the result, "none" leaves it to the operator. Production refuses the stand-in.
# Work and income are shown with documents (BA-16), kept in DOCUMENT_STORE and read by the AI.
IDENTITY_PROVIDER=stand_in
# Stripe Identity (IDENTITY_PROVIDER=stripe): the secret key (sk_test_… on the test copy) and the
# signing secret of the webhook that sends identity events to /api/webhooks/stripe-identity.
# STRIPE_SECRET_KEY=
# STRIPE_IDENTITY_WEBHOOK_SECRET=
# ADR-0005: 32 random bytes, base64 (openssl rand -base64 32). Required in production.
# DATA_ENCRYPTION_KEY=

# Sign-in (UX-SI-1, Q30, ADR-0015). Email codes and passkeys need nothing here. "Continue with
# Google" and "Continue with Apple" are each switched on by setting both of their values; with
# neither, the button isn't shown. Locally, with DEV_TOOLS=1 and these left empty, a stand-in
# page takes their place (/dev/sign-in/google), so nothing needs a real account to build.
# Google: an OAuth client (web application). Redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: the Services ID, and what its client secret is made from (BA-8): the team ID, the Sign
# in with Apple key's ID, and the key itself (the .p8 file's text; line breaks may be written as
# \n). Gaff makes the secret on the server, so it never has to be renewed by hand. A static
# APPLE_CLIENT_SECRET (a token signed with Apple's key, good for six months) still works in their
# place. Return URL: <APP_URL>/api/auth/callback/apple. Register MAIL_FROM_DOMAIN with Apple too,
# so "Hide My Email" addresses can be reached (UX-SI-11).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CLIENT_SECRET=
