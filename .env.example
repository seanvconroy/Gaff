# Local development. Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgres://gaff:gaff@localhost:5432/gaff_dev
APP_URL=http://localhost:3000
# At least 32 random characters: openssl rand -base64 32
AUTH_SECRET=replace-with-at-least-32-random-characters

# Providers. Locally: a development outbox, a fake SMS sender and a fake AI.
EMAIL_PROVIDER=dev
SMS_PROVIDER=fake
AI_PROVIDER=fake
INBOUND_DOMAIN=in.gaff.test
MAIL_FROM_DOMAIN=mail.gaff.test

# Shows the development outbox at /dev/outbox. Must be 0 in production.
DEV_TOOLS=1

# Mailgun, EU region (EMAIL_PROVIDER=mailgun)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_WEBHOOK_SIGNING_KEY=

# Sinch, EU region (SMS_PROVIDER=sinch)
SINCH_SERVICE_PLAN_ID=
SINCH_API_TOKEN=
SINCH_FROM=

# Claude on Amazon Bedrock, EU (AI_PROVIDER=bedrock). Credentials come from the standard AWS variables.
AWS_REGION=eu-west-1
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5

# Retention, in line with open question Q3. The solicitor confirms these before launch.
RETENTION_PERSONAL_DAYS=30
RETENTION_RECORD_MONTHS=12
